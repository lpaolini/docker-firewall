add table bridge fw
delete table bridge fw
table bridge fw {
	set open_bridges {
		type ifname
	}
	set peers4 {
		type ipv4_addr
		flags interval
	}
	set peers6 {
		type ipv6_addr
		flags interval
	}
	map out_by_port {
		type iface_index : verdict
	}
	map in_by_port {
		type iface_index : verdict
	}
	chain from_container {
		type filter hook prerouting priority -150; policy accept;
		iif vmap @out_by_port
		iifname "veth*" meta ibrname != @open_bridges counter drop
	}
	chain to_container {
		type filter hook postrouting priority -150; policy accept;
		oif vmap @in_by_port
		oifname "veth*" meta obrname != @open_bridges counter drop
	}
	chain from_host {
		type filter hook output priority -150; policy accept;
		oifname "veth*" ip saddr @peers4 counter drop
		oifname "veth*" ip6 saddr @peers6 counter drop
	}
}
